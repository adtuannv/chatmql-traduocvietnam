// ── Saved Report ────────────────────────────────────────────────────
// Saved analytics report configuration
model SavedReport {
  id        String    @id @default(uuid())
  orgId     String    @map("org_id")
  name      String
  type      String // conversion_funnel, team_performance, response_time, custom
  config    Json      @default("{}")
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  lastRunAt DateTime? @map("last_run_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("saved_reports")
}

// ── AI Config ───────────────────────────────────────────────────────
// AI provider configuration per organization
model AiConfig {
  id                      String   @id @default(uuid())
  orgId                   String   @unique @map("org_id")
  provider                String   @default("openai")
  model                   String   @default("gpt-4o-mini")
  maxDaily                Int      @default(500) @map("max_daily")
  enabled                 Boolean  @default(true)
  // Per-task overrides — JSON shape:
  //   { reply_draft?: { provider?, model? }, summary?: {...}, sentiment?: {...}, lead_score?: {...} }
  // Missing key OR null fields fall back to the default provider/model above.
  taskOverrides           Json     @default("{}") @map("task_overrides")
  // ── AI auto-reply (M1) ──
  defaultAiMode           String   @default("manual") @map("default_ai_mode") // manual, auto, suggest
  autoReplyEnabled        Boolean  @default(false) @map("auto_reply_enabled") // org master switch
  debounceSeconds         Int      @default(5) @map("debounce_seconds")
  prefilterKeywords       String?  @map("prefilter_keywords") // Pass 0 cheap handoff keywords
  // Trong nhóm, AI trả lời mọi câu là phá hội thoại của người thật. Bật cờ này
  // thì chỉ những tin có nhắc tên mới được trả lời.
  groupRequireMention     Boolean  @default(true) @map("group_require_mention")
  // Các tên gọi coi là "được nhắc", cách nhau bằng dấu phẩy. Trống thì dùng
  // tên các bot đang bật của tổ chức.
  mentionNames            String?  @map("mention_names")
  // ── RAG + embeddings (M3) ──
  ragTopK                 Int      @default(5) @map("rag_top_k") // number of KB entries to retrieve
  ragMinScore             Float?   @map("rag_min_score") // min cosine similarity for a RAG hit (null = default 0.35)
  embeddingProvider       String?  @map("embedding_provider") // e.g. openai
  embeddingModel          String?  @map("embedding_model") // e.g. text-embedding-3-small
  // ── RAG guardrail: restrict what the responder may retrieve (empty = no limit = all) ──
  allowedProductCategoryIds   String[] @default([]) @map("allowed_product_category_ids")
  allowedKnowledgeCategoryIds String[] @default([]) @map("allowed_knowledge_category_ids")
  // ── Trace retention (M3) ──
  traceRetentionDays      Int      @default(14) @map("trace_retention_days") // info-level trace TTL
  traceErrorRetentionDays Int      @default(90) @map("trace_error_retention_days") // error-level trace TTL
  // ── Critic / verify-before-send (P6, opt-in) ──
  verifyBeforeSend        Boolean  @default(false) @map("verify_before_send") // critic checks reply (grounding/policy) before send; fail → handoff
  // ── Auto-learn (M3, opt-in) ──
  autoLearnEnabled        Boolean  @default(false) @map("auto_learn_enabled") // AI self-tuning opt-in
  autoLearnIntervalDays   Int      @default(7) @map("auto_learn_interval_days") // how often auto-learn runs
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("ai_configs")
}

// ── AI Suggestion ───────────────────────────────────────────────────
// AI-generated suggestions for conversations
model AiSuggestion {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  conversationId String   @map("conversation_id")
  messageId      String?  @map("message_id")
  type           String // reply_suggestion, summary, sentiment
  content        String
  confidence     Float
  accepted       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([conversationId, createdAt])
  @@index([orgId, type, createdAt])
  @@map("ai_suggestions")
}

// ── AI Usage ────────────────────────────────────────────────────────
// Per-call token + cost ledger for quota, billing visibility, analytics.
model AiUsage {
  id                  String   @id @default(uuid())
  orgId               String   @map("org_id")
  provider            String // anthropic, gemini, openai
  model               String
  type                String // reply_draft, summary, sentiment, lead_score
  conversationId      String?  @map("conversation_id")
  contactId           String?  @map("contact_id")
  tokensIn            Int      @default(0) @map("tokens_in")
  tokensOut           Int      @default(0) @map("tokens_out")
  cacheReadTokens     Int      @default(0) @map("cache_read_tokens")
  cacheCreationTokens Int      @default(0) @map("cache_creation_tokens")
  costUsd             Decimal  @default(0) @map("cost_usd") @db.Decimal(10, 6)
  feature             String?  @map("feature") // auto_reply, manual_suggest, ai_master, embedding, analyze
  aiReplyRunId        String?  @map("ai_reply_run_id") // group calls of one harness turn
  createdAt           DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, type, createdAt])
  @@index([orgId, provider, createdAt])
  @@index([orgId, feature])
  @@map("ai_usage")
}

// ── AI Logic Doc ────────────────────────────────────────────────────
// Markdown "brain" docs (index/persona/playbook/handoff_rules/mechanism).
// AI Master edits these; the responder runs the org default mode on them.
model AiLogicDoc {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  type      String // index, persona, playbook, handoff_rules, mechanism
  content   String
  version   Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  updatedBy String?  @map("updated_by") // userId or 'ai_master'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org      Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions AiLogicDocVersion[]

  @@unique([orgId, type]) // one current doc per type per org (history in versions)
  @@index([orgId, type])
  @@map("ai_logic_docs")
}

// ── AI Logic Doc Version ────────────────────────────────────────────
// Version history for AiLogicDoc — enables revert.
model AiLogicDocVersion {
  id         String   @id @default(uuid())
  docId      String   @map("doc_id")
  version    Int
  content    String
  changedBy  String?  @map("changed_by") // userId or 'ai_master'
  changeNote String?  @map("change_note")
  createdAt  DateTime @default(now()) @map("created_at")

  doc AiLogicDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, version])
  @@map("ai_logic_doc_versions")
}

// ── AI Scenario (skill) ─────────────────────────────────────────────
// Modular logic unit. Unlike the fixed AiLogicDoc types, scenarios are
// add/remove-able skills. loadMode='always' → injected every turn; 'auto' →
// injected only when semantically relevant to the turn (embedding of the
// description, selected via the same RAG threshold). Scales to many scenarios
// because only descriptions are embedded and only relevant detail is loaded.
model AiScenario {
  id           String                       @id @default(uuid())
  orgId        String                       @map("org_id")
  key          String // stable slug, unique per org
  name         String // human title
  description  String // short summary — embedded + shown in the overview pass
  content      String // full detail (markdown logic)
  loadMode     String                       @default("auto") @map("load_mode") // always | auto
  enabled      Boolean                      @default(true)
  triggerHints String?                      @map("trigger_hints") // optional keywords, embedded alongside the description
  priority     Int                          @default(0) // ordering for always-loaded scenarios
  embedding    Unsupported("vector(1536)")? // description (+hints) embedding; HNSW index via raw SQL
  version      Int                          @default(1)
  updatedBy    String?                      @map("updated_by") // userId or 'ai_master'
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")

  org      Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions AiScenarioVersion[]

  @@unique([orgId, key])
  @@index([orgId, loadMode, enabled])
  @@map("ai_scenarios")
}

// Version history for AiScenario — enables revert + audit of Master edits.
model AiScenarioVersion {
  id          String   @id @default(uuid())
  scenarioId  String   @map("scenario_id")
  version     Int
  name        String
  description String
  content     String
  loadMode    String   @map("load_mode")
  changedBy   String?  @map("changed_by")
  changeNote  String?  @map("change_note")
  createdAt   DateTime @default(now()) @map("created_at")

  scenario AiScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, version])
  @@map("ai_scenario_versions")
}

// ── AI Bot ("con AI") ───────────────────────────────────────────────
// Nhiều Agent AI trong cùng tổ chức. Bộ train (kho tri thức, kịch bản, logic
// docs) dùng CHUNG ở cấp org; mỗi bot chỉ có riêng persona/playbook/model/
// tools và danh sách KÊNH mà nó phục vụ. Field null = kế thừa cấu hình org.
model AiBot {
  id                String   @id @default(uuid())
  orgId             String   @map("org_id")
  name              String
  avatarEmoji       String?  @map("avatar_emoji")
  description       String?
  enabled           Boolean  @default(true)
  provider          String? // null = org/task default
  model             String?
  personaPrompt     String?  @map("persona_prompt") // overrides org persona doc
  playbookPrompt    String?  @map("playbook_prompt") // overrides org playbook doc
  toolsJson         Json?    @map("tools_json") // per-bot ToolsConfig override
  channelAccountIds Json     @default("[]") @map("channel_account_ids") // channels this bot serves
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("ai_bots")
}

// ── AI Reply Run ────────────────────────────────────────────────────
// Lightweight per-turn record of the auto-reply harness (kept long-term).
// Heavy step trace lives in AiTrace (added in M2).
model AiReplyRun {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  conversationId  String   @map("conversation_id")
  mode            String // auto, suggest
  status          String // sent, drafted, handoff, skipped, error
  confidence      Float? // log-only (D15)
  handoff         Boolean  @default(false)
  decisionJson    String?  @map("decision_json")
  promptVersionId String?  @map("prompt_version_id")
  abBucket        String?  @map("ab_bucket")
  usageId         String?  @map("usage_id")
  latencyMs       Int?     @map("latency_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, conversationId])
  @@index([orgId, status])
  @@map("ai_reply_runs")
}

// ── Knowledge Entry (M3) ─────────────────────────────────────────────
// Global knowledge base for RAG retrieval (FAQ, policy, price, etc.)
// Embeddings/pgvector deferred — keyword search used until then.
model KnowledgeEntry {
  id         String                       @id @default(uuid())
  orgId      String                       @map("org_id")
  type       String // faq | description | policy | price | commitment | fact (legacy; phân nhóm chính = categoryId)
  format     String                       @default("article") // qa | article (render hỏi-đáp vs bài viết)
  categoryId String?                      @map("category_id") // nhóm knowledge (FK KnowledgeCategory)
  productId  String?                      @map("product_id") // gắn sản phẩm (null = kiến thức chung)
  title      String? // kiến thức (format article) không có tiêu đề; FAQ dùng title làm câu hỏi
  content    String
  keywords   String? // cách hỏi / tên gọi khác — tăng recall RAG
  status     String // active | pending | rejected | archived
  mediaUrls  String[]                     @default([]) @map("media_urls")
  mediaType  String?                      @db.VarChar(16) @map("media_type")
  risk       String // low | sensitive
  source     String // ai_extracted | staff_manual | feedback | gap_resolved
  confidence Float?                       @default(0)
  version    Int                          @default(1)
  embedding  Unsupported("vector(1536)")? // OpenAI text-embedding-3-small; HNSW index via raw SQL
  createdAt  DateTime                     @default(now()) @map("created_at")
  updatedAt  DateTime                     @updatedAt @map("updated_at")

  org      Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category KnowledgeCategory?      @relation(fields: [categoryId], references: [id])
  product  Product?                @relation(fields: [productId], references: [id])
  versions KnowledgeEntryVersion[]

  @@index([orgId, status])
  @@index([orgId, type])
  @@index([orgId, categoryId])
  @@index([orgId, productId])
  @@map("knowledge_entries")
}

// ── Knowledge Entry Version ──────────────────────────────────────────
// Audit/revert history for KnowledgeEntry edits.
model KnowledgeEntryVersion {
  id         String   @id @default(uuid())
  entryId    String   @map("entry_id")
  version    Int
  content    String
  changedBy  String?  @map("changed_by") // userId or 'ai'
  changeNote String?  @map("change_note")
  createdAt  DateTime @default(now()) @map("created_at")

  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, version])
  @@map("knowledge_entry_versions")
}

// ── Contact Memory (M3) ──────────────────────────────────────────────
// Per-contact facts extracted by AI or entered by staff (preference, constraint, etc.)
model ContactMemory {
  id         String   @id @default(uuid())
  contactId  String   @map("contact_id")
  orgId      String   @map("org_id")
  kind       String // preference | constraint | fact | objection | budget
  content    String
  source     String // ai_extracted | staff_manual
  confidence Float?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([contactId, isActive])
  @@map("contact_memories")
}

// ── AI Example Bank (M3) ─────────────────────────────────────────────
// Few-shot examples for auto-reply quality improvement.
// Embeddings/pgvector deferred — keyword selection used until then.
model AiExample {
  id             String                       @id @default(uuid())
  orgId          String                       @map("org_id")
  conversationId String?                      @map("conversation_id")
  suggestionId   String?                      @map("suggestion_id") // soft-ref to AiSuggestion
  label          String // edited | exemplar
  inputContext   String                       @map("input_context") // condensed context snapshot for few-shot
  aiDraft        String                       @map("ai_draft")
  finalText      String?                      @map("final_text") // staff-edited version that was sent
  editDiff       String?                      @map("edit_diff") // diff for learning signal
  embedding      Unsupported("vector(1536)")? // OpenAI text-embedding-3-small; HNSW index via raw SQL
  createdAt      DateTime                     @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, label])
  @@map("ai_examples")
