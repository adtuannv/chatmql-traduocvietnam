generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Organization ────────────────────────────────────────────────────
// Top-level org — every resource is scoped to an org
model Organization {
  id        String    @id @default(uuid())
  name      String
  status    String    @default("active") @map("status") // active | suspended
  expiresAt DateTime? @map("expires_at") // null = unlimited (single-company default)
  plan      String?   @map("plan") // optional label, no billing logic yet
  adminNotes String?  @map("admin_notes") // internal notes by super admin
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  teams                 Team[]
  users                 User[]
  channelAccounts       ChannelAccount[]
  contacts              Contact[]
  conversations         Conversation[]
  appointments          Appointment[]
  tasks                 Task[]
  automationRules       AutomationRule[]
  messageTemplates      MessageTemplate[]
  activityLogs          ActivityLog[]
  dailyStats            DailyMessageStat[]
  settings              AppSetting[]
  duplicateGroups       DuplicateGroup[]
  savedReports          SavedReport[]
  integrations          Integration[]
  aiConfig              AiConfig?
  aiSuggestions         AiSuggestion[]
  aiUsage               AiUsage[]
  pinnedConversations   PinnedConversation[]
  groupPolls            GroupPoll[]
  notifications         Notification[]
  channelContacts       ChannelContact[]
  channelGroups         ChannelGroup[]
  channelGroupMembers   ChannelGroupMember[]
  notes                 Note[]
  customProperties      CustomProperty[]
  contactPropertyValues ContactPropertyValue[]
  cdpEvents             CdpEvent[]
  segments              Segment[]
  lifecycleLogs         LifecycleLog[]
  cdpEventDefinitions   CdpEventDefinition[]
  automationDelayJobs   AutomationDelayJob[]
  automationTriggerJobs AutomationTriggerJob[]
  companies             Company[]
  znsLogs               ZnsLog[]
  znsCampaigns          ZnsCampaign[]
  externalSyncRefs      ExternalSyncRef[]
  syncOutbox            SyncOutbox[]
  aiLogicDocs           AiLogicDoc[]
  aiScenarios           AiScenario[]
  aiReplyRuns           AiReplyRun[]
  knowledgeEntries      KnowledgeEntry[]
  contactMemories       ContactMemory[]
  aiExamples            AiExample[]
  aiPromptVersions      AiPromptVersion[]
  aiFeedback            AiFeedback[]
  aiLogicProposals      AiLogicProposal[]
  aiMasterSessions      AiMasterSession[]
  aiTraces              AiTrace[]
  aiBots                AiBot[]
  products              Product[]
  productCategories     ProductCategory[]
  knowledgeCategories   KnowledgeCategory[]
  quotes                Quote[]
  quoteTemplates        QuoteTemplate[]
  quoteEvents           QuoteEvent[]
  websiteWidgets        WebsiteWidget[]
  productDocs           ProductDoc[]
  docFolders            DocFolder[]
  docAssets             DocAsset[]
  aiEvalCases           AiEvalCase[]
  aiEvalRuns            AiEvalRun[]
  roles                 Role[]

  @@map("organizations")
}

// ── Team ────────────────────────────────────────────────────────────
// Team groups within an organization for member assignment
model Team {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users User[]

  @@map("teams")
}

// ── Widget Live Chat cho website ────────────────────────────────────
/// Một website được phép nhúng nút chat. Một tổ chức có thể có nhiều website,
/// mỗi cái một `siteKey` riêng để phân biệt nguồn khách và cấu hình giao diện.
model WebsiteWidget {
  id      String @id @default(uuid())
  orgId   String @map("org_id")
  name    String // "Website Tra Duoc Viet Nam", "Landing khuyến mãi"…

  /// Khoá nhúng vào mã trang — CÔNG KHAI, không phải bí mật. Chặn lạm dụng bằng
  /// danh sách tên miền bên dưới chứ không bằng cách giấu khoá này.
  siteKey String @unique @map("site_key")

  /// Tên miền được phép nhúng. Mảng rỗng = cho phép mọi nơi (chỉ nên dùng khi thử).
  domains  Json    @default("[]")
  isActive Boolean @default(true) @map("is_active")

  // ── Giao diện ──
  /// Tên thương hiệu khách nhìn thấy trong cửa sổ chat. Khác `name` — `name`
  /// chỉ để quản trị viên phân biệt các website trong danh sách.
  displayName  String? @map("display_name")
  /// URL logo hiện trên nút chat và đầu cửa sổ. Rỗng → dùng icon mặc định.
  logoUrl      String? @map("logo_url")
  title        String @default("Chat với chúng tôi")
  greeting     String @default("Xin chào! Chúng tôi có thể giúp gì cho bạn?")
  primaryColor String @default("#0045ff") @map("primary_color")
  /// right | left — vị trí nút trên màn hình.
  position     String @default("right")

  // ── Kênh hiện trên nút bấm ──
  liveChatEnabled Boolean @default(true) @map("live_chat_enabled")
  zaloUrl         String? @map("zalo_url")
  facebookUrl     String? @map("facebook_url")
  phoneNumber     String? @map("phone_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("website_widgets")
}

// ── Phân quyền động (RBAC) ──────────────────────────────────────────
// Thay dần cho cột `User.role` cố định 4 giá trị. Giai đoạn chuyển tiếp: cả hai
// cùng tồn tại, `User.role` vẫn là nguồn quyết định cho tới khi chuyển xong.

/// Danh mục quyền do HỆ THỐNG định nghĩa (seed từ permission-registry.ts).
/// Tổ chức không tạo/xoá được — chỉ chọn khi dựng vai trò.
model Permission {
  key       String   @id // "contacts.delete" = <module>.<action>
  module    String // contacts, conversations, ai…
  action    String // view, create, update, delete, import, export, approve…
  label     String // "Xoá khách hàng"
  group     String // Nhóm hiển thị trên ma trận: "Khách hàng"
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// Vai trò của một tổ chức. Gồm CẢ quyền tính năng lẫn phạm vi dữ liệu —
/// tách hai thứ này ra từng khiến Hội thoại và Khách hàng lệch nhau.
model Role {
  id          String  @id @default(uuid())
  orgId       String  @map("org_id")
  name        String
  description String?
  /// Vai trò gốc (owner/admin/manager/member): không xoá, không đổi tên.
  isSystem    Boolean @default(false) @map("is_system")
  /// Khớp với giá trị `User.role` cũ. Null = vai trò do tổ chức tự tạo.
  systemKey   String? @map("system_key")
  /// all | team | own — đọc bởi shared/data-scope.ts
  dataScope   String  @default("own") @map("data_scope")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]

  @@unique([orgId, name])
  @@index([orgId, systemKey])
  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id")
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

// ── User ────────────────────────────────────────────────────────────
// CRM user with role-based access
model User {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  teamId       String?  @map("team_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         String   @default("member") // owner, admin, manager, member
  /// Vai trò động (bảng Role). Trong giai đoạn chuyển tiếp có thể null —
  /// khi null thì hệ thống vẫn dùng cột `role` ở trên.
  roleId       String?  @map("role_id")
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  org              Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team             Team?                  @relation(fields: [teamId], references: [id])
  roleRef          Role?                  @relation(fields: [roleId], references: [id])
  channelAccounts  ChannelAccount[]
  channelAccess    ChannelAccountAccess[]
  assignedContacts Contact[]              @relation("AssignedContacts")
  appointments     Appointment[]
  assignedTasks    Task[]                 @relation("AssignedTasks")
  createdTasks     Task[]                 @relation("CreatedTasks")
  repliedMessages  Message[]              @relation("RepliedMessages")
  activityLogs     ActivityLog[]
  messageTemplates MessageTemplate[]
  notifications    Notification[]
  createdNotes     Note[]                 @relation("CreatedNotes")
  ownedCompanies   Company[]              @relation("OwnedCompanies")
  assignedQuotes   Quote[]                @relation("AssignedQuotes")
  znsLogs          ZnsLog[]               @relation("ZnsSent")
  znsCampaigns     ZnsCampaign[]          @relation("ZnsCampaignCreator")
  // Manager hierarchy: multi-manager support via junction table
  managedMembers   UserManager[]          @relation("ManagerOf") // members I manage
  managers         UserManager[]          @relation("ManagedBy") // managers above me

  @@map("users")
}

// ── Channel Account ─────────────────────────────────────────────────
// A messaging channel account linked to a user (Zalo OA, Zalo Personal,
// or future platforms like Facebook Page). Platform is stored as Int for
// high-performance indexing on message-heavy tables.
// Platform: 1=ZALO_OA, 2=ZALO_USER, 10=FACEBOOK_PAGE (reserved)
model ChannelAccount {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  ownerUserId     String    @map("owner_user_id")
  platform        Int       @default(2) // 1=ZALO_OA, 2=ZALO_USER (see constants.ts Platform)
  externalUid     String?   @unique @map("external_uid") // Platform-specific user ID
  externalPageId  String?   @map("external_page_id") // Page/OA ID (distinct from user ID)
  displayName     String?   @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  phone           String?
  status          String    @default("disconnected") // connected, disconnected, qr_pending
  isDisabled      Boolean   @default(false) @map("is_disabled")
  sessionData     Json?     @map("session_data") // Zalo personal: zca-js session
  accessTokenEnc  String?   @map("access_token_enc") // OA: AES-256-GCM ciphertext
  refreshTokenEnc String?   @map("refresh_token_enc") // OA: AES-256-GCM ciphertext
  tokenExpiresAt  DateTime? @map("token_expires_at") // OA: access_token expiry
  oaScopes        String?   @map("oa_scopes") // OA: space-separated scopes
  lastConnectedAt DateTime? @map("last_connected_at")
  // Soft-delete marker. Historical data (conversations, messages) stays
  // accessible; account just hides from integrations list.
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  org                 Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner               User                   @relation(fields: [ownerUserId], references: [id])
  access              ChannelAccountAccess[]
  conversations       Conversation[]
  dailyStats          DailyMessageStat[]
  channelContacts     ChannelContact[]
  channelGroups       ChannelGroup[]
  channelGroupMembers ChannelGroupMember[]
  znsTemplates        ZnsTemplate[]
  znsLogs             ZnsLog[]
  znsCampaigns        ZnsCampaign[]

  @@unique([orgId, externalPageId])
  @@index([orgId, platform])
  @@map("channel_accounts")
}

// ── Channel Account Access (ACL) ────────────────────────────────────
// ACL: which users can access which channel accounts
model ChannelAccountAccess {
  id               String   @id @default(uuid())
  channelAccountId String   @map("channel_account_id")
  userId           String   @map("user_id")
  permission       String   @default("read") // read, chat, admin
  createdAt        DateTime @default(now()) @map("created_at")

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, userId])
  @@map("channel_account_access")
}

// ── Contact ─────────────────────────────────────────────────────────
// CRM contact record. lifecycleStage drives Lead/Customer classification
// (subscriber → lead → qualified → opportunity → customer → evangelist → churned).
// Optional companyId links to Company for B2B workflows.
model Contact {
  id                    String    @id @default(uuid())
  orgId                 String    @map("org_id")
  companyId             String?   @map("company_id")
  zaloUid               String?   @map("zalo_uid")
  pancakeUid            String?   @map("pancake_uid")  // Pancake page_customer_id
  fbPsid                String?   @map("fb_psid")      // Facebook Page-scoped ID (native Messenger)
  tiktokUid             String?   @map("tiktok_uid")   // TikTok Buyer UID / OpenID (native TikTok Shop)
  phone                 String?
  email                 String?
  fullName              String?   @map("full_name")
  crmName               String?   @map("crm_name") // Operator-assigned display name
  avatarUrl             String?   @map("avatar_url")
  jobTitle              String?   @map("job_title")
  isPrimaryContact      Boolean   @default(false) @map("is_primary_contact")
  source                String? // FB, TT, GT, CN, Zalo, Web, etc.
  sourceDate            DateTime? @map("source_date")
  firstContactDate      DateTime? @map("first_contact_date")
  lifecycleStage        String    @default("subscriber") @map("lifecycle_stage")
  nextAppointment       DateTime? @map("next_appointment")
  assignedUserId        String?   @map("assigned_user_id")
  notes                 String?
  tags                  Json      @default("[]")
  metadata              Json      @default("{}")
  isGroup               Boolean   @default(false) @map("is_group")
  leadScore             Int       @default(0) @map("lead_score")
  lastActivity          DateTime? @map("last_activity")
  // ── Customer 360 AI Insights (persistent) ────────────────────
  aiSummary             String?   @map("ai_summary")
  aiSentimentLabel      String?   @map("ai_sentiment_label") // positive/neutral/negative
  aiSentimentConfidence Float?    @map("ai_sentiment_confidence")
  aiSentimentReason     String?   @map("ai_sentiment_reason")
  aiIntent              String?   @map("ai_intent") // cold/warm/hot
  aiPainPoints          Json      @default("[]") @map("ai_pain_points")
  aiCompetitors         Json      @default("[]") @map("ai_competitors")
  aiSignals             Json      @default("[]") @map("ai_signals")
  aiAnalyzedAt          DateTime? @map("ai_analyzed_at")
  aiConversationId      String?   @map("ai_conversation_id")
  mergedInto            String?   @map("merged_into")
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  org               Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company           Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedUser      User?                  @relation("AssignedContacts", fields: [assignedUserId], references: [id])
  mergedIntoContact Contact?               @relation("ContactMerge", fields: [mergedInto], references: [id])
  mergedFrom        Contact[]              @relation("ContactMerge")
  conversations     Conversation[]
  appointments      Appointment[]
  propertyValues    ContactPropertyValue[]
  cdpEvents         CdpEvent[]
  lifecycleLogs     LifecycleLog[]
  quotes            Quote[]

  @@index([orgId, phone])
  @@index([orgId, zaloUid])
  @@index([orgId, pancakeUid])
  @@index([orgId, fbPsid])
  @@index([orgId, tiktokUid])
  @@index([orgId, mergedInto])
  @@index([orgId, lifecycleStage])
  @@index([orgId, companyId])
  @@map("contacts")
}

// ── Company ─────────────────────────────────────────────────────────
// B2B account. Optional 1:N parent of Contact — a Contact belongs to 0 or 1
// Company. Company itself has no lifecycle column (per 2026-05-15 decision);
// classification is read off its contacts.
model Company {
  id        String    @id @default(uuid())
  orgId     String    @map("org_id")
  name      String
  taxCode   String?   @map("tax_code")
  industry  String?
  size      String?
  website   String?
  address   String?
  phone     String?
  email     String?
  ownerId   String?   @map("owner_id")
  notes     String?
  tags      Json      @default("[]")
  metadata  Json      @default("{}")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner    User?        @relation("OwnedCompanies", fields: [ownerId], references: [id])
  contacts Contact[]
  quotes   Quote[]

  @@index([orgId, name])
  @@index([orgId, taxCode])
  @@index([orgId, deletedAt])
  @@map("companies")
}

// ── Conversation ────────────────────────────────────────────────────
// A chat thread between a channel account and a contact (or group)
model Conversation {
  id                       String    @id @default(uuid())
  orgId                    String    @map("org_id")
  channelAccountId         String    @map("channel_account_id")
  contactId                String?   @map("contact_id")
  threadType               String    @default("user") // user, group
  externalThreadId         String?   @map("external_thread_id")
  lastMessageAt            DateTime? @map("last_message_at")
  unreadCount              Int       @default(0) @map("unread_count")
  isReplied                Boolean   @default(true) @map("is_replied")
  tab                      String    @default("main") @map("tab") // main, other
  isPinned                 Boolean   @default(false) @map("is_pinned")
  displayName              String?   @map("display_name") // Original name on this channel — survives contact merge
  aiMode                   String    @default("manual") @map("ai_mode") // manual, auto, suggest (AI auto-reply mode)
  aiModeReason             String?   @map("ai_mode_reason")
  aiPausedUntil            DateTime? @map("ai_paused_until")
  assignedUserId           String?   @map("assigned_user_id") // handoff assignee (soft ref to User)
  aiRollingSummary         String?   @map("ai_rolling_summary") // L5 overflow summary
  lastAiProcessedMessageId String?   @map("last_ai_processed_message_id") // debounce idempotency
  createdAt                DateTime  @default(now()) @map("created_at")

  org             Organization                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channelAccount  ChannelAccount               @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  contact         Contact?                     @relation(fields: [contactId], references: [id])
  messages        Message[]
  aiSuggestions   AiSuggestion[]
  pins            PinnedConversation[]
  idleCheckpoints ConversationIdleCheckpoint[]

  @@unique([channelAccountId, externalThreadId])
  @@index([orgId, channelAccountId, isReplied, lastMessageAt])
  @@index([orgId, channelAccountId, lastMessageAt])
  @@index([orgId, tab, lastMessageAt])
  @@map("conversations")
}

// ── Message ─────────────────────────────────────────────────────────
// Individual message within a conversation
model Message {
  id              String    @id @default(uuid())
  conversationId  String    @map("conversation_id")
  externalMsgId   String?   @map("external_msg_id")
  senderType      String    @map("sender_type") // self, contact, system (see constants.ts SenderType)
  senderUid       String?   @map("sender_uid")
  senderName      String?   @map("sender_name")
  content         String?
  contentType     String    @default("text") @map("content_type") // text, image, file, sticker, voice, video, link
  attachments     Json      @default("[]")
  quote           Json?     @map("quote")
  albumKey        String?   @map("album_key") // Zalo group_layout_id — multi-image albums
  albumIndex      Int?      @map("album_index") // 0-based position within album
  albumTotal      Int?      @map("album_total") // total items in album
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")
  sentAt          DateTime  @map("sent_at")
  repliedByUserId String?   @map("replied_by_user_id")
  aiGenerated     Boolean   @default(false) @map("ai_generated") // marker for AI-sent messages
  aiReplyRunId    String?   @map("ai_reply_run_id") // soft ref to AiReplyRun
  responseSource  String?   @map("response_source") // who produced this outbound reply: null=none, manual, ai_auto, ai_suggest (see constants.ts ResponseSource)
  znsLogId        String?   @map("zns_log_id") // link to ZnsLog for zns_template messages (delivery lifecycle)
  createdAt       DateTime  @default(now()) @map("created_at")

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  repliedBy    User?             @relation("RepliedMessages", fields: [repliedByUserId], references: [id])
  znsLog       ZnsLog?           @relation(fields: [znsLogId], references: [id])
  reactions    MessageReaction[]

  @@unique([conversationId, externalMsgId])
  @@index([conversationId, albumKey])
  @@map("messages")
}

// ── Message Reaction ────────────────────────────────────────────────
// Emoji reaction on a message (ported from openzca msg react)
model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  reactorId String   @map("reactor_id") // Zalo UID of the person who reacted
  emoji     String // ❤️ 👍 😆 😮 😭 😡
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, reactorId])
  @@map("message_reactions")
}

// ── Pinned Conversation ─────────────────────────────────────────────
// Pinned conversation (ported from openzca msg pin)
model PinnedConversation {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  channelAccountId String   @map("channel_account_id")
  conversationId   String   @map("conversation_id")
  pinnedAt         DateTime @default(now()) @map("pinned_at")

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, conversationId])
  @@map("pinned_conversations")
}

// ── Appointment ─────────────────────────────────────────────────────
// Appointment scheduled for a contact
model Appointment {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  contactId       String?  @map("contact_id")
  assignedUserId  String?  @map("assigned_user_id")
  appointmentDate DateTime @map("appointment_date")
  appointmentTime String?  @map("appointment_time")
  type            String?
  status          String   @default("scheduled") // scheduled, completed, cancelled, no_show
  notes           String?
  reminderSent    Boolean  @default(false) @map("reminder_sent")
  createdAt       DateTime @default(now()) @map("created_at")

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation(fields: [assignedUserId], references: [id])

  @@map("appointments")
}

// ── Task ────────────────────────────────────────────────────────────
// CRM task / to-do item scoped to org
model Task {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  title           String
  description     String?
  priority        String    @default("medium") // low, medium, high, urgent
  status          String    @default("todo") // todo, in_progress, done, cancelled
  dueDate         DateTime? @map("due_date")
  assignedUserId  String?   @map("assigned_user_id")
  createdByUserId String    @map("created_by_user_id")
  contactId       String?   @map("contact_id")
  conversationId  String?   @map("conversation_id")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("AssignedTasks", fields: [assignedUserId], references: [id])
  createdBy    User         @relation("CreatedTasks", fields: [createdByUserId], references: [id])

  @@index([orgId, status, dueDate])
  @@index([orgId, assignedUserId, status])
  @@map("tasks")
}

