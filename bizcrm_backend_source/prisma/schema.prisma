  @@index([orgId, resolved])
  @@map("duplicate_groups")
}

// ── Conversation Idle Checkpoint ────────────────────────────────────
// Dedup table for conversation_idle automation trigger.
// Tracks the lastMessageAt that was already processed per threshold.
model ConversationIdleCheckpoint {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  threshold      String // '30m', '1h', '24h'
  lastCheckedAt  DateTime @map("last_checked_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, threshold])
  @@map("conversation_idle_checkpoints")
