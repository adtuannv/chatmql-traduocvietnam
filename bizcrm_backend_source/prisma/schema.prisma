// ── AI Prompt Version (M3) ───────────────────────────────────────────
// Versioned prompt templates for technical scaffolding (ai_router / auto_reply / ai_master).
// NOT prose logic — that lives in AiLogicDoc. Supports A/B testing via abBucket.
model AiPromptVersion {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String // auto_reply | persona | ai_router | ai_master
  version   Int
  content   String
  isActive  Boolean  @default(false) @map("is_active")
  abBucket  String?  @map("ab_bucket") // 'A' | 'B' for A/B testing
  createdAt DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, name, isActive])
  @@map("ai_prompt_versions")
}

// ── AI Feedback (M3) ─────────────────────────────────────────────────
// Staff free-text feedback on AI replies; drives AiLogicProposal generation.
model AiFeedback {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  conversationId String?  @map("conversation_id") // soft-ref
  messageId      String?  @map("message_id") // soft-ref to Message
  aiReplyRunId   String?  @map("ai_reply_run_id") // soft-ref to AiReplyRun
  authorUserId   String   @map("author_user_id")
  text           String
  category       String? // tone | accuracy | policy | missing_info | other
  isExemplar     Boolean  @default(false) @map("is_exemplar") // flag reply as training example
  status         String   @default("new") @map("status") // new | reviewed | applied | dismissed
  createdAt      DateTime @default(now()) @map("created_at")

  org       Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  proposals AiLogicProposal[]

  @@index([orgId, status])
  @@index([orgId, conversationId])
  @@map("ai_feedback")
}

// ── AI Logic Proposal (M3) ───────────────────────────────────────────
// AI pending ACTION (P7) — the responder requests a mutating action (e.g. book an
// appointment); staff must CONFIRM before it executes. NEVER auto-executed.
// org_id is a soft-ref scalar (no FK) like AiTrace.
model AiPendingAction {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  conversationId String?  @map("conversation_id")
  contactId      String?  @map("contact_id")
  type           String // request_appointment (extensible)
  payload        Json     @default("{}")
  summary        String? // human-readable one-liner for the review UI
  status         String   @default("pending") // pending | confirmed | rejected
  reviewedBy     String?  @map("reviewed_by")
  executedRef    String?  @map("executed_ref") // id of created entity (e.g. Appointment)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([orgId, status])
  @@map("ai_pending_actions")
}

// AiKnowledgeGap — when the AI lacks data/knowledge to answer during a live chat,
// it logs a gap via the fire-and-forget `log_knowledge_gap` tool (does NOT interrupt
// the reply). Staff resolve it into a KnowledgeEntry (close-the-loop) so the AI can
// answer next time. org_id is a soft-ref scalar (no FK) like AiPendingAction.
model AiKnowledgeGap {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  conversationId String?  @map("conversation_id")
  contactId      String?  @map("contact_id")
  aiReplyRunId   String?  @map("ai_reply_run_id")
  messageId      String?  @map("message_id")
  gapType        String   @map("gap_type") // missing_info | needs_knowledge | needs_staff
  question       String // câu hỏi / khoảng trống AI gặp phải
  suggestion     String? // "Đề Xuất" của AI (recommendation)
  status         String   @default("open") // open | resolved | dismissed
  occurrences    Int      @default(1) // dedupe counter (gộp gap trùng)
  resolvedBy     String?  @map("resolved_by")
  resolvedRef    String?  @map("resolved_ref") // KnowledgeEntry id (resolve trực tiếp) hoặc AiFeedback id (route Master)
  notes          String?
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([orgId, status])
  @@map("ai_knowledge_gaps")
}

// Long-lived API key for programmatic / MCP access (per org). The raw key is
// shown ONCE on creation; only its sha256 hash is stored. Grants admin-level
// API access scoped to its org; revoke by setting revokedAt.
model ApiKey {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  name        String // human label, e.g. "MCP — Claude Desktop"
  prefix      String // first chars for display (e.g. "bzk_a1b2…")
  keyHash     String    @unique @map("key_hash") // sha256 of the full raw key
  createdById String?   @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([orgId])
  @@map("api_keys")
}

// AI-generated proposals to update KnowledgeEntry / AiLogicDoc / AiPromptVersion.
// Requires staff approval before being applied. NEVER auto-applied.
model AiLogicProposal {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  feedbackId      String?  @map("feedback_id") // source if immediate proposal
  masterSessionId String?  @map("master_session_id") // source if from AiMasterSession
  source          String // feedback | consolidation | master_session
  targetType      String   @map("target_type") // logic_doc | knowledge_entry | thread_memory | prompt_version
  targetSubtype   String?  @map("target_subtype") // persona | playbook | handoff_rules | index
  targetId        String?  @map("target_id") // id of the object to update
  currentValue    String?  @map("current_value")
  proposedValue   String   @map("proposed_value")
  rationale       String
  status          String   @default("pending") // pending | approved | rejected | applied
  createdByAi     Boolean  @default(true) @map("created_by_ai")
  reviewedBy      String?  @map("reviewed_by") // userId who reviewed
  appliedRef      String?  @map("applied_ref") // id of created KnowledgeEntry / AiPromptVersion after apply
  createdAt       DateTime @default(now()) @map("created_at")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  feedback AiFeedback?  @relation(fields: [feedbackId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@map("ai_logic_proposals")
}

// ── AI Master Session (M3) ───────────────────────────────────────────
// Agentic Logic Editor session — full tool-loop for reviewing and improving AI logic.
model AiMasterSession {
  id                    String   @id @default(uuid())
  orgId                 String   @map("org_id")
  openedByUserId        String   @map("opened_by_user_id")
  contextConversationId String?  @map("context_conversation_id") // soft-ref
  seedFeedbackId        String?  @map("seed_feedback_id") // opened from feedback box
  status                String   @default("active") // active | closed
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages AiMasterMessage[]

  @@index([orgId, status])
  @@map("ai_master_sessions")
}

// ── AI Master Message (M3) ───────────────────────────────────────────
// Turn-by-turn messages in an AiMasterSession (user / assistant / tool).
model AiMasterMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  role      String // user | assistant | tool
  content   String?
  toolName  String?  @map("tool_name")
  toolData  Json?    @map("tool_data") // tool call args + result
  createdAt DateTime @default(now()) @map("created_at")

  session AiMasterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("ai_master_messages")
}

// ── AI Trace (M3) ────────────────────────────────────────────────────
// Per-step debug trace for the auto-reply harness. Heavy, soft-ref (no FK),
// purgeable independently of Conversation/Message. TTL set per retention config.
model AiTrace {
  id             String    @id @default(uuid())
  orgId          String    @map("org_id")
  conversationId String?   @map("conversation_id") // soft-ref, NO FK cascade
  aiReplyRunId   String?   @map("ai_reply_run_id") // soft-ref to AiReplyRun
  step           String // assemble | router | retrieve | generator | tool | error
  level          String    @default("info") @map("level") // info | error
  payload        Json // JSONB: context snapshot, prompt, raw output, KB hits, tokens
  latencyMs      Int?      @map("latency_ms")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime? @map("expires_at") // purge cutoff (info ~14d, error ~90d)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, conversationId])
  @@index([createdAt])
  @@index([expiresAt]) // purge by expiresAt — requires index
  @@index([level, createdAt]) // purge by level+age (info 14d / error 90d)
  @@map("ai_traces")
}

// ── ZNS Template (cache) ────────────────────────────────────────────
// Per-OA cache of ZNS templates pulled from Zalo portal. Refreshed on
// demand (TTL ~1h). status is Zalo's lifecycle: ENABLE / DISABLE /
// PENDING_REVIEW. params is the dynamic schema (name, type, required,
// maxLength, acceptNull) we render into a form in ZnsSendModal.
model ZnsTemplate {
  id               String   @id @default(uuid())
  channelAccountId String   @map("channel_account_id")
  templateId       String   @map("template_id") // Zalo numeric template id
  templateName     String   @map("template_name")
  status           String   @default("ENABLE") // ENABLE, DISABLE, PENDING_REVIEW
  templateType     String?  @map("template_type") // OTP, TRANSACTION, PROMOTION
  params           Json     @default("[]")
  previewUrl       String?  @map("preview_url")
  fetchedAt        DateTime @default(now()) @map("fetched_at")

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, templateId])
  @@index([channelAccountId, status])
  @@map("zns_templates")
}

// ── ZNS Log (audit + delivery) ──────────────────────────────────────
// Every ZNS send creates a row. trackingId is our UUID we pass to Zalo
// as tracking_id so the delivery webhook can flip status → DELIVERED.
// status: pending, sent, delivered, read, failed, rejected.
model ZnsLog {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  channelAccountId String    @map("channel_account_id")
  contactId        String?   @map("contact_id")
  conversationId   String?   @map("conversation_id")
  templateId       String    @map("template_id")
  phone            String // normalized 84xxxxxxxxx
  paramsJson       Json      @default("{}") @map("params_json")
  trackingId       String    @unique @map("tracking_id") // our UUID
  externalMsgId    String?   @map("external_msg_id") // returned by platform API
  status           String    @default("pending") // pending, sent, delivered, read, failed, rejected
  errorCode        String?   @map("error_code")
  errorMessage     String?   @map("error_message")
  sentByUserId     String    @map("sent_by_user_id")
  sentAt           DateTime  @default(now()) @map("sent_at")
  deliveredAt      DateTime? @map("delivered_at")

  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  sentBy         User           @relation("ZnsSent", fields: [sentByUserId], references: [id])
  messages       Message[]

  @@index([orgId, sentAt])
  @@index([channelAccountId, status])
  @@index([contactId, sentAt])
  @@map("zns_logs")
}

// ── ZNS Campaign (mass-send) ────────────────────────────────────────
// One ZNS template fanned out across many recipients via the zns-send
// BullMQ queue. Recipients can come from an explicit contact-id list or
// from a saved Segment (evaluated at start time, snapshotted into rows).
// templateData supports {{contact.field}} placeholders rendered per-recipient.
model ZnsCampaign {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  channelAccountId String    @map("channel_account_id")
  name             String
  templateId       String    @map("template_id")
  templateData     Json      @default("{}") @map("template_data")
  contactIds       Json      @default("[]") @map("contact_ids") // String[] snapshot
  status           String    @default("draft") // draft, queued, running, completed, failed, cancelled
  scheduledAt      DateTime? @map("scheduled_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  totalCount       Int       @default(0) @map("total_count")
  sentCount        Int       @default(0) @map("sent_count")
  failedCount      Int       @default(0) @map("failed_count")
  skippedCount     Int       @default(0) @map("skipped_count")
  createdByUserId  String    @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  org            Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount         @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  createdBy      User                   @relation("ZnsCampaignCreator", fields: [createdByUserId], references: [id])
  recipients     ZnsCampaignRecipient[]

  @@index([orgId, status, createdAt])
  @@map("zns_campaigns")
}

// One row per recipient enqueued. Populated when the campaign is started.
model ZnsCampaignRecipient {
  id           String    @id @default(uuid())
  campaignId   String    @map("campaign_id")
  contactId    String?   @map("contact_id")
  phone        String // normalized 84xxx
  status       String    @default("pending") // pending, sent, failed, skipped
  znsLogId     String?   @map("zns_log_id")
  errorMessage String?   @map("error_message")
  processedAt  DateTime? @map("processed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  campaign ZnsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([contactId])
  @@map("zns_campaign_recipients")
}

// ── Group Poll ──────────────────────────────────────────────────────
// Group poll (ported from openzca group poll)
model GroupPoll {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  channelAccountId String    @map("channel_account_id")
  groupExternalId  String    @map("group_external_id")
  zaloPollId       String    @map("zalo_poll_id")
  question         String
  options          Json      @default("[]") // [{id, text, voteCount}]
  isMultiChoice    Boolean   @default(false) @map("is_multi_choice")
  isAnonymous      Boolean   @default(false) @map("is_anonymous")
  isLocked         Boolean   @default(false) @map("is_locked")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, zaloPollId])
  @@index([orgId, groupExternalId])
  @@map("group_polls")
}

// ── Notification ────────────────────────────────────────────────────
// In-app notifications for users
model Notification {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  userId    String   @map("user_id")
  type      String   @default("message") // message, contact, appointment, automation
  title     String
  body      String   @default("")
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([orgId, createdAt])
  @@map("notifications")
}

// ── Channel Contact ──────────────────────────────────────────────────
// Synced contact/friend from a channel account
model ChannelContact {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  channelAccountId String   @map("channel_account_id")
  friendUid        String   @map("friend_uid") // Platform UID of contact
  displayName      String   @map("display_name")
  avatarUrl        String?  @map("avatar_url")
  phone            String?
  isFavorite       Boolean  @default(false) @map("is_favorite")
  isBlocked        Boolean  @default(false) @map("is_blocked")
  syncedAt         DateTime @default(now()) @map("synced_at")
  createdAt        DateTime @default(now()) @map("created_at")

  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, friendUid])
  @@index([orgId, displayName])
  @@index([channelAccountId])
  @@map("channel_contacts")
}

// ── Channel Group ───────────────────────────────────────────────────
// Synced group list from a channel account
model ChannelGroup {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  channelAccountId String   @map("channel_account_id")
  groupId          String   @map("group_id") // Platform group ID
  name             String
  avatarUrl        String?  @map("avatar_url")
  memberCount      Int      @default(0) @map("member_count")
  isAdmin          Boolean  @default(false) @map("is_admin")
  isMuted          Boolean  @default(false) @map("is_muted")
  syncedAt         DateTime @default(now()) @map("synced_at")
  createdAt        DateTime @default(now()) @map("created_at")

  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, groupId])
  @@index([orgId, name])
  @@index([channelAccountId])
  @@map("channel_groups")
}

// ── Channel Group Member ────────────────────────────────────────────
// Cached member list of a channel group; populated on first fetch
// and updated incrementally from group events.
model ChannelGroupMember {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  channelAccountId String   @map("channel_account_id")
  groupId          String   @map("group_id") // Platform group ID (= Conversation.externalThreadId)
  memberUid        String   @map("member_uid")
  displayName      String?  @map("display_name")
  avatarUrl        String?  @map("avatar_url")
  isAdmin          Boolean  @default(false) @map("is_admin")
  syncedAt         DateTime @default(now()) @updatedAt @map("synced_at")
  createdAt        DateTime @default(now()) @map("created_at")

  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, groupId, memberUid])
  @@index([channelAccountId, groupId])
  @@index([orgId])
  @@map("channel_group_members")
}

// ── Note ────────────────────────────────────────────────────────────
// Internal note attached to a contact or conversation
model Note {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  contactId       String?  @map("contact_id")
  conversationId  String?  @map("conversation_id")
  createdByUserId String   @map("created_by_user_id")
  content         String
  status          String?  @db.VarChar(32)
  isPinned        Boolean  @default(false) @map("is_pinned")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation("CreatedNotes", fields: [createdByUserId], references: [id])

  @@index([orgId, contactId, createdAt])
  @@index([orgId, conversationId, createdAt])
  @@map("notes")
}

// ══════════════════════════════════════════════════════════════════════
// CDP — Customer Data Platform
// ══════════════════════════════════════════════════════════════════════

// ── Custom Property ─────────────────────────────────────────────────
// Schema-defined custom fields for contacts (text, number, date, boolean, select, multi_select)
model CustomProperty {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  name        String // Human-readable label
  fieldKey    String   @map("field_key") // Machine key (snake_case)
  fieldType   String   @map("field_type") // text, number, date, boolean, single_select, multi_select
  options     Json     @default("[]") // For select types: [{value, label, color}]
  isRequired  Boolean  @default(false) @map("is_required")
  groupName   String?  @map("group_name") // Optional grouping category
  sortOrder   Int      @default(0) @map("sort_order")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org    Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  values ContactPropertyValue[]

  @@unique([orgId, fieldKey])
  @@index([orgId, sortOrder])
  @@map("custom_properties")
}

// ── Contact Property Value ──────────────────────────────────────────
// Stores a contact's value for a custom property (EAV pattern)
model ContactPropertyValue {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  contactId  String   @map("contact_id")
  propertyId String   @map("property_id")
  value      String   @default("") // Stored as text, parsed by fieldType
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact  Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  property CustomProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([contactId, propertyId])
  @@index([orgId, propertyId])
  @@map("contact_property_values")
}

// ── CDP Event ───────────────────────────────────────────────────────
// Behavioral event tracked for a contact (page_view, purchase, form_submit, custom, etc.)
model CdpEvent {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  contactId  String   @map("contact_id")
  eventName  String   @map("event_name") // page_view, purchase, form_submit, status_change, etc.
  properties Json     @default("{}") // Arbitrary event data
  source     String? // api, system, zalo, web, etc.
  sessionId  String?  @map("session_id")
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now()) @map("created_at")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([orgId, eventName, timestamp])
  @@index([contactId, timestamp])
  @@index([orgId, timestamp])
  @@map("cdp_events")
}

// ── Segment ─────────────────────────────────────────────────────────
// Dynamic customer segment with filter conditions
model Segment {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  name             String
  description      String?
  conditions       Json      @default("[]") // [{type, field, operator, value}] with AND/OR groups
  contactCount     Int       @default(0) @map("contact_count")
  lastCalculatedAt DateTime? @map("last_calculated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("segments")
}

// ── Lifecycle Log ───────────────────────────────────────────────────
// Records lifecycle stage transitions for a contact
model LifecycleLog {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  contactId String   @map("contact_id")
  fromStage String?  @map("from_stage")
  toStage   String   @map("to_stage")
  changedBy String?  @map("changed_by") // userId or "system"
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([orgId, toStage, createdAt])
  @@map("lifecycle_logs")
}

// ── CDP Event Definition ────────────────────────────────────────────
// Event dictionary mapping machine keys to human-readable names and schema
model CdpEventDefinition {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  eventName   String   @map("event_name")
  displayName String   @map("display_name")
  description String?
  schema      Json     @default("{}") // Expected properties schema
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, eventName])
  @@map("cdp_event_definitions")
}

// ── Automation Delay Job ────────────────────────────────────────────
// Deferred DAG continuation — persists delay node state so the flow
// can be resumed after minutes/hours/days even across server restarts.
model AutomationDelayJob {
  id                String   @id @default(uuid())
  orgId             String   @map("org_id")
  ruleId            String   @map("rule_id")
  flowConfig        Json     @map("flow_config")
  resumeFromNodeIds String[] @map("resume_from_node_ids")
  context           Json     @default("{}")
  executeAt         DateTime @map("execute_at")
  status            String   @default("pending") // pending, running, done, failed
  createdAt         DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status, executeAt])
  @@index([orgId, ruleId])
  @@map("automation_delay_jobs")
}

// ── Automation Trigger Job ──────────────────────────────────────────
// Queue-based trigger dispatch — instead of fire-and-forget promises,
// triggers are persisted here and processed by a poller. This prevents
// main thread blocking and survives server restarts.
model AutomationTriggerJob {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  trigger   String // e.g. 'status_changed', 'tag_added'
  context   Json     @default("{}") // AutomationContext serialized
  status    String   @default("pending") // pending, running, done, failed
  attempts  Int      @default(0)
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([orgId, trigger])
  @@map("automation_trigger_jobs")
}

// ── Refresh Token ───────────────────────────────────────────────────
// W5-FIX: Short-lived access token (30 min) + long-lived refresh token (7 days).
// Token rotation: each refresh invalidates the old token and issues a new pair.
// Family-based revocation: if a revoked token is reused, the entire family is
// wiped to mitigate stolen-token replay attacks.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique // crypto.randomUUID() — opaque
  family    String // groups tokens for rotation chain
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at") // set when rotated or explicitly logged out
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ── Manager Hierarchy (M:N) ─────────────────────────────────────────
// Junction table: which managers supervise which members.
// A member can have multiple managers; a manager can have multiple members.
model UserManager {
  id        String   @id @default(uuid())
  managerId String   @map("manager_id")
  memberId  String   @map("member_id")
  createdAt DateTime @default(now()) @map("created_at")

  manager User @relation("ManagerOf", fields: [managerId], references: [id], onDelete: Cascade)
  member  User @relation("ManagedBy", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([managerId, memberId])
  @@index([memberId])
  @@map("user_managers")
}

// ── External Sync Ref (PerfexCRM & future platforms) ────────────────
// Durable local↔external id mapping. Symmetric: reusable for future reverse pull.
// Connection/config lives in the existing `Integration` model (type='perfex').
model ExternalSyncRef {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  system       String    @default("perfex") // future: other platforms
  localType    String    @map("local_type") // 'company' | 'contact' | 'lead'
  localId      String    @map("local_id")
  externalId   String    @map("external_id") // Perfex numeric id (stored as string)
  lastHash     String?   @map("last_hash") // hash of last-pushed payload → skip no-op pushes
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, system, localType, localId])
  @@index([orgId, system, localType, externalId])
  @@map("external_sync_refs")
}

// ── Sync Outbox (transactional outbox for debounced push) ───────────
// Transient push intents. A debounced per-org worker coalesces + flushes these to Perfex.
model SyncOutbox {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  localType    String    @map("local_type") // 'company' | 'contact' | 'lead'
  localId      String    @map("local_id")
  op           String // 'upsert' | 'delete'
  status       String    @default("pending") // pending | processing | done | failed | skipped
  attempts     Int       @default(0)
  errorMessage String?   @map("error_message")
  skipReason   String?   @map("skip_reason") // e.g. 'no_company'
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  processedAt  DateTime? @map("processed_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status, localType])
  @@index([orgId, localType, localId]) // for coalescing
  @@map("sync_outbox")
}

// ── Platform Admin (super admin / multi-tenant control plane) ────────
// Separate identity from org Users. Logs in via /platform, manages all
// organizations. NOT scoped to any org. email is unique within this table
// only (decoupled from users.email).
model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens PlatformRefreshToken[]
  auditLogs     PlatformAuditLog[]

  @@map("platform_admins")
}

// Refresh token rotation for platform admins (mirrors RefreshToken).
model PlatformRefreshToken {
  id        String    @id @default(uuid())
  adminId   String    @map("admin_id")
  token     String    @unique
  family    String
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([family])
  @@map("platform_refresh_tokens")
}

// Audit trail for platform-admin actions. targetOrgId/targetUserId are
// soft references (plain columns, no FK) — purgeable, survive org deletion.
model PlatformAuditLog {
  id           String   @id @default(uuid())
  adminId      String   @map("admin_id")
  action       String // org.create | org.update | org.license | account.create | enter_company | ...
  targetOrgId  String?  @map("target_org_id")
  targetUserId String?  @map("target_user_id")
  meta         Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([targetOrgId])
  @@map("platform_audit_logs")
}

// ── Platform Setting ────────────────────────────────────────────────
// Platform-wide (not org-scoped) key-value settings owned by super admins.
// Used for white-label branding (brand name, logo, favicon). Image rows keep
// bytes in `valueBytes` and their MIME type in `valueText`; text settings keep
// their value in `valueText`. Singleton per key.
model PlatformSetting {
  id         String   @id @default(uuid())
  settingKey String   @unique @map("setting_key") // brand_name | brand_logo | brand_favicon
  valueText  String?  @map("value_text")          // brand name, or MIME type for image rows
  valueBytes Bytes?   @map("value_bytes")          // image bytes for logo/favicon rows
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ── Product Knowledge Base ──────────────────────────────────────────
// Product catalog + category tree. Knowledge/FAQ lives in KnowledgeEntry
// (linked via productId/categoryId). All org-scoped + composite-unique per org.

// Product category tree (catalog classification). specSchema = template for
// standardizing product `specs` JSON; importConfig = Google Sheet sync config.
model ProductCategory {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  parentId     String?  @map("parent_id")
  name         String
  slug         String
  description  String?
  icon         String?
  specSchema   Json     @default("{}") @map("spec_schema") // { fields: [{key,label,type}] }
  importConfig Json     @default("{}") @map("import_config") // Google Sheet sync (url, tab, mapping, mode)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("ProductCatTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("ProductCatTree")
  products Product[]

  @@unique([orgId, slug])
  @@index([orgId, parentId])
  @@map("product_categories")
}

model Product {
  id               String                       @id @default(uuid())
  orgId            String                       @map("org_id")
  categoryId       String?                      @map("category_id")
  name             String
  code             String? // SKU
  slug             String
  description      String?
  notes            String? // ghi chú nội bộ
  keywords         String? // alias/synonyms — recall RAG
  tags             String[]                     @default([])
  priceType        String                       @default("fixed") @map("price_type") // fixed (cố định) | range (khoảng giá) | contact (báo giá) | free (miễn phí) | description (giá ghi trong mô tả)
  price            Decimal?                     @db.Decimal(14, 2) // giá cố định, hoặc cận DƯỚI khi priceType=range
  priceMax         Decimal?                     @db.Decimal(14, 2) @map("price_max") // cận TRÊN, chỉ dùng khi priceType=range
  currency         String                       @default("VND")
  specs            Json                         @default("{}") // thuộc tính linh hoạt, chuẩn theo category.specSchema
  images           String[]                     @default([])
  videoUrls        String[]                     @default([]) @map("video_urls") // link video (YouTube/mp4) cho tài liệu bán hàng
  status           String                       @default("active") // draft | active | archived
  sortOrder        Int                          @default(0) @map("sort_order")
  source           String                       @default("manual") // manual | import | sync | ai_master
  embedding        Unsupported("vector(1536)")? // name + short + keywords
  createdById      String?                      @map("created_by_id")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id])
  knowledge KnowledgeEntry[]
  quoteLines QuoteLine[]

  @@unique([orgId, code])
  @@unique([orgId, slug])
  @@index([orgId, categoryId])
  @@index([orgId, status])
  @@map("products")
}

// Knowledge category tree (sales/consulting taxonomy: company info, FAQ,
// policy, pricing, sales scripts…). Separate from ProductCategory.
model KnowledgeCategory {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  parentId     String?  @map("parent_id")
  name         String
  slug         String
  description  String?
  kind         String   @default("knowledge") // knowledge (bài viết) | faq (câu hỏi thường gặp) — mỗi nhóm chỉ 1 loại
  importConfig Json     @default("{}") @map("import_config") // Google Sheet sync per group
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  org      Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   KnowledgeCategory?  @relation("KnowledgeCatTree", fields: [parentId], references: [id])
  children KnowledgeCategory[] @relation("KnowledgeCatTree")
  entries  KnowledgeEntry[]

  @@unique([orgId, slug])
  @@index([orgId, parentId])
  @@map("knowledge_categories")
}

// ── Quote / Contract (Báo giá & Hợp đồng) ───────────────────────────
// Chứng từ bán hàng gắn với 1 Contact (Company optional, thường đọc từ contact).
// Vòng đời: draft → sent → viewed → accepted | rejected | expired | canceled
// parentId: báo giá v1 → v2 (revise khi deal giá) hoặc báo giá → hợp đồng.
// Đã gửi (sent+) thì BẤT BIẾN — muốn sửa phải revise ra bản mới.
model Quote {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  contactId        String    @map("contact_id")
  companyId        String?   @map("company_id")
  parentId         String?   @map("parent_id") // bản gốc khi revise / convert

  number           String // BG-2026-0001 — unique THEO ORG
  type             String    @default("quote") // quote (báo giá) | contract (hợp đồng)
  status           String    @default("draft") // draft | sent | viewed | accepted | rejected | expired | canceled
  publicToken      String    @unique @map("public_token") // link khách xem, không đoán được
  title            String?
  currency         String    @default("VND")

  subtotal         Decimal   @default(0) @db.Decimal(14, 2) // tổng dòng SAU chiết khấu dòng
  discountType     String    @default("none") @map("discount_type") // none | percent | amount
  discountValue    Decimal   @default(0) @db.Decimal(14, 2) @map("discount_value")
  discountAmount   Decimal   @default(0) @db.Decimal(14, 2) @map("discount_amount")
  taxRate          Decimal   @default(0) @db.Decimal(5, 2) @map("tax_rate") // VAT VN: 0 | 5 | 8 | 10
  taxAmount        Decimal   @default(0) @db.Decimal(14, 2) @map("tax_amount")
  total            Decimal   @default(0) @db.Decimal(14, 2)

  notes            String? // điều khoản / ghi chú HIỂN THỊ cho khách
  internalNotes    String?   @map("internal_notes") // chỉ nội bộ, không lộ ra route public
  templateId       String?   @map("template_id")
  templateSnapshot Json      @default("{}") @map("template_snapshot") // đóng băng thông tin bên bán lúc gửi

  assignedUserId   String?   @map("assigned_user_id")
  createdById      String?   @map("created_by_id")
  source           String    @default("manual") // manual | ai | automation | import
  validUntil       DateTime? @map("valid_until")
  sentAt           DateTime? @map("sent_at")
  sentVia          String?   @map("sent_via") // zalo | zalo_oa | facebook | email | link
  firstViewedAt    DateTime? @map("first_viewed_at")
  lastViewedAt     DateTime? @map("last_viewed_at")
  viewCount        Int       @default(0) @map("view_count")
  respondedAt      DateTime? @map("responded_at")
  rejectReason     String?   @map("reject_reason")

  deletedAt        DateTime? @map("deleted_at") // soft delete — chứng từ tài chính
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  parent       Quote?         @relation("QuoteLineage", fields: [parentId], references: [id])
  revisions    Quote[]        @relation("QuoteLineage")
  template     QuoteTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignedUser User?          @relation("AssignedQuotes", fields: [assignedUserId], references: [id])
  lines        QuoteLine[]
  events       QuoteEvent[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, contactId])
  @@index([orgId, companyId])
  @@index([orgId, assignedUserId])
  @@index([orgId, deletedAt])
  @@map("quotes")
}

// Dòng hàng. name/unitPrice là SNAPSHOT lúc tạo — sản phẩm đổi tên/xoá sau này
// KHÔNG được làm đổi báo giá đã gửi khách.
model QuoteLine {
  id              String   @id @default(uuid())
  quoteId         String   @map("quote_id")
  productId       String?  @map("product_id") // chỉ để truy vết

  name            String // snapshot tên sản phẩm/dịch vụ
  description     String?
  quantity        Decimal  @default(1) @db.Decimal(12, 3) // 3 số lẻ: 0.5 ngày công, 2.75 m²
  unit            String   @default("cái")
  unitPrice       Decimal  @db.Decimal(14, 2) @map("unit_price")
  discountPercent Decimal  @default(0) @db.Decimal(5, 2) @map("discount_percent")
  amount          Decimal  @db.Decimal(14, 2)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId, sortOrder])
  @@map("quote_lines")
}

// Mẫu báo giá: thông tin bên bán + điều khoản mặc định + quy tắc đánh số.
// Field CÓ CẤU TRÚC (không phải HTML tự do) → an toàn XSS, AI đọc được.
model QuoteTemplate {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  name             String
  isDefault        Boolean  @default(false) @map("is_default")

  sellerName       String?  @map("seller_name")
  sellerTaxCode    String?  @map("seller_tax_code") // MST
  sellerAddress    String?  @map("seller_address")
  sellerPhone      String?  @map("seller_phone")
  sellerEmail      String?  @map("seller_email")
  logoUrl          String?  @map("logo_url")
  bankInfo         String?  @map("bank_info") // STK / ngân hàng / chủ TK
  signerName       String?  @map("signer_name")
  signerTitle      String?  @map("signer_title")

  termsText        String?  @map("terms_text")
  footerNote       String?  @map("footer_note")
  numberPrefix     String   @default("BG") @map("number_prefix")
  defaultTaxRate   Decimal  @default(0) @db.Decimal(5, 2) @map("default_tax_rate")
  defaultValidDays Int      @default(30) @map("default_valid_days")
  accentColor      String?  @map("accent_color")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  quotes Quote[]

  @@unique([orgId, name])
  @@index([orgId, isDefault])
  @@map("quote_templates")
}

// Audit trail + tracking hành vi khách. actorType theo pattern actorKind của ZNS.
model QuoteEvent {
  id        String   @id @default(uuid())
  quoteId   String   @map("quote_id")
  orgId     String   @map("org_id")
  type      String // created | updated | sent | viewed | accepted | rejected | expired | canceled | reminded | revised
  actorType String   @default("user") @map("actor_type") // user | contact | system | ai
  actorId   String?  @map("actor_id")
  meta      Json     @default("{}") // { from, to, channel, ip, userAgent, … }
  createdAt DateTime @default(now()) @map("created_at")

  quote Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([orgId, type, createdAt])
  @@map("quote_events")
}

// Bộ đếm số chứng từ theo org + kỳ. Tăng ATOMIC trong cùng transaction với
// việc tạo quote → không bao giờ trùng số dù nhiều user bấm cùng lúc.
model QuoteCounter {
  orgId     String   @map("org_id")
  period    String // "2026" hoặc "2026-07"
  seq       Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([orgId, period])
  @@map("quote_counters")
}

// ── AI Eval ("bộ câu hỏi vàng") ──────────────────────────────────────
// Regression-eval cho AI: admin giữ bộ câu hỏi chuẩn + tiêu chí chấm;
// mỗi lượt chạy sinh trả lời qua đường simulate (không chạm khách thật)
// rồi để LLM chấm đạt/trượt. Xem src/modules/ai/ai-eval-service.ts.
model AiEvalCase {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  name           String
  question       String // tin nhắn khách hàng để mô phỏng
  criteria       String // tiêu chí chấm (rubric) cho giám khảo LLM
  conversationId String?  @map("conversation_id") // hội thoại thật (tuỳ chọn) làm ngữ cảnh mô phỏng
  botId          String?  @map("bot_id") // ép dùng một Agent cụ thể (tuỳ chọn)
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("ai_eval_cases")
}

model AiEvalRun {
  id         String    @id @default(uuid())
  orgId      String    @map("org_id")
  trigger    String // manual | proposal
  proposalId String?   @map("proposal_id") // AiLogicProposal được kiểm định (nếu có)
  model      String? // model giám khảo đã dùng
  status     String    @default("running") // running | done | failed
  total      Int       @default(0)
  passed     Int       @default(0)
  failed     Int       @default(0)
  errored    Int       @default(0)
  note       String?
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  results AiEvalResult[]

  @@index([orgId])
  @@map("ai_eval_runs")
}

model AiEvalResult {
  id        String   @id @default(uuid())
  runId     String   @map("run_id")
  caseId    String   @map("case_id")
  caseName  String   @map("case_name")
  question  String
  reply     String? // null khi AI quyết định không trả lời / lỗi sinh
  verdict   String // pass | fail | error
  reason    String
  latencyMs Int?     @map("latency_ms")
  createdAt DateTime @default(now()) @map("created_at")

  run AiEvalRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("ai_eval_results")
}

/// Tài liệu bán hàng của MỘT sản phẩm (ảnh, mô tả, video) — tri thức do ChatMQL
/// sở hữu, gắn vào sản phẩm theo MÃ (productCode) chứ không theo id bảng
/// `products` nội bộ. Nhờ vậy khi chuyển sang nguồn sản phẩm chính thức của
/// TDVN, toàn bộ tài liệu đã soạn vẫn bám đúng sản phẩm.
/// Vừa là tư liệu cho nhân viên, vừa là nguồn tri thức AI đọc khi tư vấn.
model ProductDoc {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  /// Danh mục trong CÂY tài liệu bán hàng (doc_folders). Nhờ nó sản phẩm xếp
  /// được nhiều cấp (Trà > Trà xanh), không phụ thuộc danh mục phẳng của CRM.
  folderId    String?  @map("folder_id")
  /// Mã sản phẩm ở hệ thống nguồn. Khoá liên kết duy nhất.
  productCode String   @map("product_code")
  /// Tên tại thời điểm soạn — để hiện khi hệ thống nguồn lỗi/chậm.
  name        String?
  description String?
  images      String[] @default([])
  videoUrls   String[] @default([]) @map("video_urls")
  /// Từ khoá/tên gọi khác, giúp AI tìm đúng tài liệu.
  keywords    String?
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folder DocFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([orgId, productCode])
  @@index([orgId, folderId])
  @@index([orgId])
  @@map("product_docs")
}

/// Thư mục của THƯ VIỆN tài liệu bán hàng — admin tự tạo, lồng nhau tuỳ ý.
/// Khác `product_docs` (tài liệu gắn cứng vào một mã sản phẩm): thư viện là kho
/// tài nguyên chung, một tài nguyên có thể dùng cho nhiều mã hoặc không mã nào
/// (biểu giá, ảnh xưởng, banner chiến dịch...).
model DocFolder {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  parentId    String?  @map("parent_id")
  name        String
  description String?
  /// Emoji hiển thị cho dễ nhận diện.
  icon        String?
  /// sales = được phép gửi khách · internal = chỉ nội bộ · ai_only = chỉ AI đọc.
  /// Tài nguyên thừa kế mức này khi tạo, và luồng gửi khách CHẶN theo cờ này.
  visibility  String   @default("sales")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   DocFolder?   @relation("DocFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children DocFolder[]  @relation("DocFolderTree")
  assets   DocAsset[]
  productDocs ProductDoc[]

  @@index([orgId, parentId])
  @@map("doc_folders")
}

/// Một tài nguyên trong thư viện: ảnh, video, pdf, tài liệu, văn bản thuần, hoặc
/// chỉ là một đường dẫn. Nhân viên tra cứu để gửi khách; AI đọc phần chữ khi tư vấn.
model DocAsset {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  folderId    String?  @map("folder_id")
  /// product | image | video | pdf | doc | text | link
  /// `product` là tài liệu bán hàng của một mặt hàng: có bộ ảnh + nhiều video,
  /// nên dùng `images`/`videoUrls` thay vì một `fileUrl` đơn lẻ.
  kind        String
  title       String
  description String?
  /// Nội dung chữ (kind=text) hoặc chữ trích từ pdf/doc — đây là phần AI đọc.
  textContent String?  @map("text_content")
  /// Đường dẫn file đã tải lên máy chủ (tương đối, ví dụ /uploads/doc-assets/...).
  fileUrl     String?  @map("file_url")
  thumbUrl    String?  @map("thumb_url")
  /// Bộ ảnh (loại `product`). Ảnh đầu tiên là ảnh đại diện.
  images      String[] @default([])
  /// Danh sách link video (YouTube/mp4).
  videoUrls   String[] @default([]) @map("video_urls")
  fileSize    Int?     @map("file_size")
  mimeType    String?  @map("mime_type")
  /// Link ngoài (Drive, YouTube...) khi không tải file về.
  sourceUrl   String?  @map("source_url")
  /// Id ở hệ thống nguồn (fileId Drive) — khoá chống nhập trùng khi chạy lại script.
  sourceId    String?  @map("source_id")
  /// Mã sản phẩm dùng tài nguyên này. Rỗng = tài nguyên chung, không theo sản phẩm.
  productCodes String[] @default([]) @map("product_codes")
  tags        String[] @default([])
  visibility  String   @default("sales")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folder DocFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([orgId, sourceId])
  @@index([orgId, folderId])
  @@index([orgId, kind])
  @@map("doc_assets")
}
